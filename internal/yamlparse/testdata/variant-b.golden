map(1) @1:1
  "gateway": map(3) @2:3
    "port": "9090" plain @2:9
    "global_timeout": "750ms" quoted @3:19
    "routes": seq(2) @5:5
      - [0] map(6) @5:7
        "path": "/v2/" quoted @5:13
        "methods": seq(2) @6:16
          - [0] "get" quoted @6:17
          - [1] "delete" quoted @6:24
        "strip_prefix": "true" plain @7:21
        "timeout": "2s" quoted @8:16
        "upstream": map(1) @10:9
          "url": "http://localhost:3002/base" quoted @10:14
        "rate_limit": map(3) @11:19
          "requests": "2" plain @11:31
          "window": "1s" quoted @11:42
          "per": "global" plain @11:53
      - [1] map(4) @12:7
        "path": "/v2/admin" quoted @12:13
